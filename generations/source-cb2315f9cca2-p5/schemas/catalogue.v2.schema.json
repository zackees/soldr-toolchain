{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zackees.github.io/soldr-toolchain/schemas/catalogue.v2.schema.json",
  "title": "soldr-toolchain catalogue v2",
  "type": "object",
  "required": ["schema_version", "generation", "publication_state", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "generation": {"$ref": "#/$defs/generation"},
    "publication_state": {"$ref": "#/$defs/publication_state"},
    "generated_at": {"type": "string"},
    "origin": {"$ref": "#/$defs/url"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generation": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "url": {"type": "string", "maxLength": 8192, "pattern": "^https://[^\\s]+$"},
    "publication_state": {
      "type": "object", "additionalProperties": false,
      "required": ["generation", "url"],
      "properties": {
        "generation": {"$ref": "#/$defs/generation"},
        "url": {"$ref": "#/$defs/url"}
      }
    },
    "urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/url"}},
    "part": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "sha256", "size_bytes", "urls"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 4096},
        "sha256": {"$ref": "#/$defs/hash"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 99614720},
        "urls": {"$ref": "#/$defs/urls"}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "repo", "tag", "asset", "sha256", "size_bytes"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "repo": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "asset": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 8796093022208},
        "source_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$).+$"},
        "min_client_version": {"type": "integer", "const": 2},
        "urls": {"$ref": "#/$defs/urls"},
        "parts": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/part"}}
      },
      "oneOf": [{"required": ["urls"]}, {"required": ["parts"]}],
      "allOf": [
        {"if": {"required": ["parts"]}, "then": {"required": ["min_client_version", "source_path"]}},
        {"if": {"required": ["urls"]}, "then": {"not": {"required": ["source_path"]}}}
      ]
    }
  }
}
